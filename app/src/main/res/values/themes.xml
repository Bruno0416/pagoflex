<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PagoFlex" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- splash al abrir la app; después vuelve al tema normal -->
    <style name="Theme.PagoFlex.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_fondo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.PagoFlex</item>
    </style>
</resources>
